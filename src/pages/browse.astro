---
import Layout from '../layouts/layout.astro';
import chatbots from '../data/chatbots.json';

// Every room opens through the gateway (login first). A room missing from this map shows as Coming soon.
const gateway = (import.meta.env.PUBLIC_GATEWAY_URL ?? "").replace(/\/$/, "");
const slug: Record<string, string> = { sdm: "sdm", move: "move", stats: "stats", connectivity: "connect", landmetrics: "landmetrics" };
const rooms = chatbots.map((bot) => ({
  ...bot,
  href: gateway && slug[bot.id] ? `${gateway}/${slug[bot.id]}/` : null,
}));
---

<Layout title="Rooms · Spatchat">
  <section class="max-w-6xl mx-auto py-10">
    <div class="text-center mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-3">Spatchat rooms</h1>
      <p class="text-slate-600 max-w-2xl mx-auto">
        Pick a room and start chatting. You'll be asked to log in first.
      </p>
    </div>

    <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {rooms.map((room) =>
        room.href ? (
          <a
            href={room.href}
            data-bot-id={room.id}
            class="bot-card block bg-white rounded-2xl border border-slate-200 p-6 hover:border-teal-600 hover:shadow-lg transition h-full"
          >
            <h2 class="text-xl font-bold text-slate-900 mb-3">{room.title}</h2>
            <div class="flex flex-wrap gap-2 text-xs mb-4">
              {room.tags.map((tag) => (
                <span class="bg-teal-50 text-teal-800 px-2.5 py-1 rounded-full">{tag}</span>
              ))}
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">{room.description}</p>
          </a>
        ) : (
          <div class="block bg-white/60 rounded-2xl border border-dashed border-slate-300 p-6 h-full">
            <div class="flex items-start justify-between gap-3 mb-3">
              <h2 class="text-xl font-bold text-slate-500">{room.title}</h2>
              <span class="shrink-0 text-xs bg-slate-100 text-slate-500 px-2.5 py-1 rounded-full">Coming soon</span>
            </div>
            <p class="text-slate-500 text-sm leading-relaxed">{room.description}</p>
          </div>
        )
      )}
    </div>
  </section>

  <script>
    // Count the click without delaying the page change.
    document.querySelectorAll(".bot-card").forEach((card) => {
      card.addEventListener("click", () => {
        const botId = (card as HTMLElement).dataset.botId;
        if (!botId) return;
        try {
          navigator.sendBeacon("/.netlify/functions/track-clicks", new Blob([JSON.stringify({ botId })], { type: "application/json" }));
        } catch {}
      });
    });

    // Old bookmarks like /browse?room=sdm go straight to the room (the gateway asks for login).
    const gateway = (document.body.dataset.gateway ?? "");
    const map: Record<string, string> = { sdm: "sdm", move: "move", stats: "stats", connectivity: "connect", landmetrics: "landmetrics" };
    const room = new URLSearchParams(location.search).get("room");
    if (gateway && room && map[room]) location.replace(`${gateway}/${map[room]}/`);
  </script>
</Layout>
