---
import "../styles/global.css";
const { title } = Astro.props;
// PUBLIC_GATEWAY_URL (e.g. https://app.spatchat.org) is where login, accounts and the chat rooms live.
const gateway = (import.meta.env.PUBLIC_GATEWAY_URL ?? "").replace(/\/$/, "");
---

<html lang="en">
  <head>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-cream-50 text-slate-800 min-h-screen font-sans flex flex-col" data-gateway={gateway}>
    <header class="bg-white border-b border-cream-200 sticky top-0 z-20">
      <nav class="max-w-6xl mx-auto px-5 py-2.5 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3 text-lg font-bold text-slate-900">
          <img src="/icons/spatchat_logo.jpg" alt="" class="h-9 w-9 rounded-lg" />
          Spatchat
        </a>
        <ul class="flex items-center gap-1 sm:gap-2 text-sm text-slate-600">
          <li><a href="/browse" class="px-3 py-2 rounded-lg hover:bg-cream-100 hover:text-slate-900">Rooms</a></li>
          <li class="hidden sm:block"><a href="/docs" class="px-3 py-2 rounded-lg hover:bg-cream-100 hover:text-slate-900">Docs</a></li>
          <li class="hidden sm:block"><a href="/about" class="px-3 py-2 rounded-lg hover:bg-cream-100 hover:text-slate-900">About</a></li>
          <li class="hidden sm:block"><a href="/join" class="px-3 py-2 rounded-lg hover:bg-cream-100 hover:text-slate-900">Join</a></li>
          {gateway && (
            <li id="auth-slot" class="ml-1">
              <a href={`${gateway}/login`} class="inline-block px-4 py-2 rounded-lg bg-brand-700 text-white font-medium hover:bg-brand-800">Log in</a>
            </li>
          )}
        </ul>
      </nav>
    </header>

    <main class="flex-1 w-full container mx-auto p-8">
      <slot />
    </main>

    <footer class="text-center py-6 text-xs text-slate-500">
      © 2025 Ho Yi Wan, Logan Hysen & Lokesh Lokesh ·
      <a href="/datapolicy" class="text-brand-800 hover:underline">Data Policy</a>
    </footer>

    <script>
      // The login lives on the gateway (another origin of this site). Ask it who is signed in so this
      // header shows an account menu instead of a Log in button, and never offers Log in twice.
      const gateway = document.body.dataset.gateway;
      const slot = document.getElementById("auth-slot");
      if (gateway && slot) {
        fetch(`${gateway}/api/me`, { credentials: "include" })
          .then((r) => (r.ok ? r.json() : null))
          .then((data) => {
            const user = data && data.user;
            if (!user) return;
            slot.innerHTML = `
              <details class="relative">
                <summary class="list-none cursor-pointer flex items-center" aria-label="Account menu">
                  <span class="h-9 w-9 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center"></span>
                </summary>
                <div class="absolute right-0 mt-2 w-56 bg-white border border-slate-200 rounded-xl shadow-lg p-1.5 text-sm">
                  <div class="px-3 py-2 text-xs text-slate-500 border-b border-slate-100 mb-1 break-all"></div>
                  <a href="${gateway}/account" class="block px-3 py-2 rounded-lg hover:bg-slate-100">Account</a>
                  <form method="post" action="${gateway}/logout">
                    <button type="submit" class="w-full text-left px-3 py-2 rounded-lg hover:bg-slate-100">Log out</button>
                  </form>
                </div>
              </details>`;
            slot.querySelector("span").textContent = user.initial || "?";
            slot.querySelector(".break-all").textContent = user.email;
            document.querySelectorAll("[data-guest-only]").forEach((el) => el.classList.add("hidden"));
            document.querySelectorAll("[data-user-only]").forEach((el) => el.classList.remove("hidden"));
          })
          .catch(() => {});
      }
    </script>
  </body>
</html>
